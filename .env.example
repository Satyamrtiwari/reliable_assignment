# Reliable Paper Mart - Environment Variables Example
# Copy this file to .env and customize as needed.

# Database & OAuth Credentials Paths
DB_PATH=marketing.db
CREDENTIALS_FILE=credentials.json
TOKEN_FILE=token.json

# Gmail Sending Compliance Caps
DAILY_SEND_LIMIT=400
SEND_DELAY_SECONDS=2.0
# Optional Reply-To header (leave empty to match authenticated Gmail sender)
REPLY_TO_EMAIL=

# FastAPI Unsubscribe Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
BASE_URL=http://localhost:8000

# Mon-Sat Scheduler Run Time (24h local time)
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=30

# Company Contact Details
COMPANY_EMAIL=sales@reliablepapermart.com
COMPANY_PHONE=+91 98200 00000
COMPANY_ADDRESS=Plot 42, Paper Market Industrial Estate, Mumbai - 400001

# Task 2: Groq AI Copywriting (Optional - get free key at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Task 2: Meta Graph API (Facebook Page & WhatsApp Cloud API)
META_GRAPH_API_VERSION=v21.0
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
TEAM_NOTIFY_EMAIL=
